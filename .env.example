# ──────────────────────────────────────────────
# Telegram — obter via @BotFather
# ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# ──────────────────────────────────────────────
# API — autenticação do endpoint /api/alerts/send
# ──────────────────────────────────────────────
ALERT_API_KEY=CHANGE_ME

# ──────────────────────────────────────────────
# CORS — origens permitidas (separadas por vírgula)
# ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_USER=pramo
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pramoao
DATABASE_URL=postgresql+asyncpg://pramo:CHANGE_ME@postgres:5432/pramoao

# ──────────────────────────────────────────────
# Redis — senha obrigatória em produção
# ──────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# ──────────────────────────────────────────────
# Flower — monitoramento Celery
# ──────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME

# ──────────────────────────────────────────────
# SerpAPI — Google Flights (https://serpapi.com)
# ──────────────────────────────────────────────
SERPAPI_KEY=CHANGE_ME
